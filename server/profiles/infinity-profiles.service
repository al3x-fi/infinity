[Unit]
Description=INFINITY profiles API
After=network.target

[Service]
User=infinity-profiles
WorkingDirectory=/opt/infinity-profiles
Environment=PORT=3101
Environment=DATA_FILE=/var/lib/infinity-profiles/profiles.json
Environment=ORIGINS=https://infinity-suhu.vercel.app,https://infinity-xi-lemon.vercel.app,https://infinity0.xyz,http://201.18.222.194,http://localhost:5173
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/infinity-profiles

[Install]
WantedBy=multi-user.target
