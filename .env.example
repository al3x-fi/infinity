# Copy to .env.local and fill in. Get an ID at https://dashboard.reown.com (public value, not a secret).
VITE_WALLETCONNECT_PROJECT_ID=

# Admin wallet tracker (/admin). From Supabase → Project Settings → API. The anon key is public;
# never put the service_role key here. Run supabase-admin.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
